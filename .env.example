# DB Config
HOST=localhost
DATABASE_PASSWORD=db_passord
DATABASE_USER=db_user
DATABASE_PORT=db_port
DATABASE=db_name
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${HOST}:${DATABASE_PORT}/${DATABASE}
SHADOW_DATABASE=shadow_db_name
SHADOW_DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${HOST}:${DATABASE_PORT}/${SHADOW_DATABASE}
# Environment
NODE_ENV=development
PORT=5000

# Rate-limit des endpoints login/OAuth (envoi OTP SMS/email).
# Défaut sécurisé = 5/min si non défini. À desserrer uniquement en local/tests.
AUTH_THROTTLE_LIMIT=5
#Cloudinary
CLOUDINARY_NAME=API_NAME
CLOUDINARY_API_KEY=API_KEY
CLOUDINARY_API_SECRET=API_SECRET
CLOUDINARY_URL=cloudinary://${CLOUDINARY_API_KEY}:{CLOUDINARY_API_SECRET}@${CLOUDINARY_NAME}
en fait je peux me service de la table mission avec plus de potentiel que d'etre simplement utilisé comme une annonces d'utilisateur, en enlevant la contrainte unique sur le champ advertisementId, je peux gerer les colis lier a une annonces et niveau logique du code je peux empecher le duplicat si il s'agit d'un annonce utilisateur

ACCESS_TOKEN_EXP="5min"
REFRESH_TOKEN_EXP="7d"

# STRIPE
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_IDENTITY_RETURN_URL=https://localhost/verification/identity/return
STRIPE_IDENTITY_REFRESH_URL=https://localhost/verification/identity/refresh
STRIPE_WEBHOOK_SECRET_IDENTITY=whsec_xxx

# GOOGLE
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# APPLE (bundle ID de ton app iOS)
# REQUIS pour activer le login Apple : sans cette valeur, la vérification
# d'audience ne peut pas se faire et le login Apple est refusé (fail-closed).
APPLE_CLIENT_ID=com.yourcompany.gpconnect

# FACEBOOK (pour le token exchange mobile)
# REQUIS pour activer le login Facebook : on vérifie via /debug_token que le
# token a bien été émis pour NOTRE app (app_id) + appsecret_proof. Sans ces
# deux valeurs, le login Facebook est refusé (fail-closed).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# MAIL
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USER=postmaster@sandbox12345.mailgun.org
MAIL_PASS=yourpassword
MAIL_FROM=no-reply@gpconnect.com

# Twilio
TWILIO_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
FRONTEND_URL=http://localhost:3000


# Suivi des litiges : une issue GitHub par litige (repo privé). Optionnel —
# sans ces variables (ou hors production), l'issue est seulement loggée.
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=owner/repo

# Back-office AdminJS (/admin). Sans ADMIN_PANEL_PASSWORD, le panel est
# entièrement désactivé. Login : email d'un user ADMIN + ce mot de passe.
ADMIN_PANEL_PASSWORD=
ADMIN_COOKIE_SECRET=

# MAILGUN API (prioritaire sur SMTP si MAILGUN_API_KEY est renseignée —
# obligatoire sur Railway hors plan Pro, qui bloque le SMTP sortant)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=sandbox12345.mailgun.org
# MAILGUN_API_BASE=https://api.eu.mailgun.net
